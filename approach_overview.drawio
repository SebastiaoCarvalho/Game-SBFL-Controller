        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.667;entryDx=0;entryDy=0;" edge="1" parent="1" source="bad" target="gen">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="672" y="246" />
              <mxPoint x="672" y="90" />
            </Array>
          </mxGeometry>
