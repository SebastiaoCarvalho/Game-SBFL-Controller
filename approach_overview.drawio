<mxfile host="app.diagrams.net">
  <diagram name="Approach Overview" id="overview">
    <mxGraphModel dx="1000" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="330" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== PHASE 1: LOGGING ===================== -->
        <mxCell id="p1" value="① Logging" style="swimlane;startSize=32;fontStyle=1;fontSize=16;rounded=1;arcSize=3;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#F4F8FD;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="270" height="310" as="geometry" />
        </mxCell>
        <mxCell id="game" value="&lt;b&gt;Game Under Test&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555555'&gt;instrumented to report&lt;br&gt;state variables &amp;amp; events&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="p1">
          <mxGeometry x="45" y="42" width="180" height="58" as="geometry" />
        </mxCell>
        <mxCell id="rs" value="State&lt;br&gt;variables" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p1">
          <mxGeometry x="12" y="134" width="76" height="42" as="geometry" />
        </mxCell>
        <mxCell id="rv" value="Video&lt;br&gt;frames" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p1">
          <mxGeometry x="97" y="134" width="76" height="42" as="geometry" />
        </mxCell>
        <mxCell id="ra" value="Audio" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="p1">
          <mxGeometry x="182" y="134" width="76" height="42" as="geometry" />
        </mxCell>
        <mxCell id="trace" value="&lt;b&gt;Gameplay Trace&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555555'&gt;synchronized,&lt;br&gt;timestamped&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="p1">
          <mxGeometry x="65" y="204" width="140" height="88" as="geometry" />
        </mxCell>

        <!-- ===================== PHASE 2: VALIDATION ===================== -->
        <mxCell id="p2" value="② Validation" style="swimlane;startSize=32;fontStyle=1;fontSize=16;rounded=1;arcSize=3;html=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#FFFBEE;" vertex="1" parent="1">
          <mxGeometry x="310" y="10" width="340" height="310" as="geometry" />
        </mxCell>
        <mxCell id="spec" value="&lt;b&gt;Specification&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;&lt;i&gt;CodeEvent&lt;/i&gt; → &lt;i&gt;Effect&lt;/i&gt;&lt;/span&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fontSize=14;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="p2">
          <mxGeometry x="20" y="40" width="150" height="62" as="geometry" />
        </mxCell>
        <mxCell id="dec" value="&lt;i&gt;Effect&lt;/i&gt;&lt;br&gt;observed at&lt;br&gt;&lt;i&gt;CodeEvent&lt;/i&gt;?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="p2">
          <mxGeometry x="20" y="128" width="150" height="100" as="geometry" />
        </mxCell>
        <mxCell id="oracle" value="Human&lt;br&gt;Test Oracle" style="shape=umlActor;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;html=1;outlineConnect=0;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="p2">
          <mxGeometry x="83" y="252" width="24" height="42" as="geometry" />
        </mxCell>
        <mxCell id="good" value="&lt;b&gt;Good states&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;&lt;i&gt;CodeEvent&lt;/i&gt; ∧ &lt;i&gt;Effect&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="p2">
          <mxGeometry x="198" y="114" width="132" height="52" as="geometry" />
        </mxCell>
        <mxCell id="bad" value="&lt;b&gt;Violations&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;&lt;i&gt;CodeEvent&lt;/i&gt; ∧ ¬&lt;i&gt;Effect&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="p2">
          <mxGeometry x="198" y="210" width="132" height="52" as="geometry" />
        </mxCell>

        <!-- ===================== PHASE 3: FAULT LOCALIZATION ===================== -->
        <mxCell id="p3" value="③ Fault Localization" style="swimlane;startSize=32;fontStyle=1;fontSize=16;rounded=1;arcSize=3;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#F8F3FA;" vertex="1" parent="1">
          <mxGeometry x="680" y="10" width="270" height="310" as="geometry" />
        </mxCell>
        <mxCell id="gen" value="&lt;b&gt;Candidate Bug Conditions&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555555'&gt;predicates over state variables,&lt;br&gt;split on good vs. violating values&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="p3">
          <mxGeometry x="20" y="40" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="score" value="&lt;b&gt;Suspiciousness Scoring&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555555'&gt;Ochiai: violations vs. good states&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="p3">
          <mxGeometry x="20" y="126" width="230" height="62" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;Ranked Bug Conditions&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555555'&gt;e.g. &lt;/span&gt;&lt;span style='font-size:12px;font-family:Courier New'&gt;player.wading == true&lt;/span&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fontSize=14;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="p3">
          <mxGeometry x="25" y="214" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES ===================== -->
        <!-- Phase 1 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="game" target="rs">
          <mxGeometry relative="1" as="geometry" />
